# Copy this file to .env and replace the placeholders with values from your resources.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL_NAME=<primary-model-deployment-name>

# Optional: set a second deployment to compare latency and response quality.
FOUNDRY_COMPARISON_MODEL_NAME=

# Lab 03: Azure AI Search and Foundry IQ. These values are not secrets.
FOUNDRY_PROJECT_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
# Use a parent Foundry resource model endpoint, not the /api/projects/... endpoint.
FOUNDRY_EMBEDDING_ENDPOINT=https://<account>.services.ai.azure.com
FOUNDRY_EMBEDDING_MODEL_NAME=<embedding-deployment-name>
FOUNDRY_EMBEDDING_MODEL=text-embedding-3-small
FOUNDRY_EMBEDDING_DIMENSIONS=1536

# Lab 03 resource names. Replace <initials> with your lowercase initials when sharing a service.
AZURE_SEARCH_INDEX_NAME=opg-maintenance-documents-<initials>
AZURE_SEARCH_KNOWLEDGE_SOURCE_NAME=opg-maintenance-source-<initials>
AZURE_SEARCH_KNOWLEDGE_BASE_NAME=opg-maintenance-knowledge-<initials>
FOUNDRY_IQ_CONNECTION_NAME=opg-maintenance-iq-<initials>
FOUNDRY_GROUNDED_AGENT_NAME=opg-grounded-maintenance-agent-<initials>
